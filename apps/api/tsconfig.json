{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["vitest/globals", "node"],
    // "@/" 指向 src/。Node 运行时不认识这个别名：nest build / nest start 编译时会把它改写成相对路径，
    // Vitest 通过 resolve.tsconfigPaths 读取这里。TypeScript 6 已弃用 baseUrl，paths 相对本文件解析
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
